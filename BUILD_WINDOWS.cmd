@echo off
setlocal EnableExtensions
cd /d "%~dp0"
rem Builds dist\NitroSystemII.dll with Zig 0.15.2 (https://ziglang.org/download/).
rem zig.exe: first argument if given (drop zig.exe onto this file), else zig from PATH.
set "ZIG=%~1"
if not defined ZIG set "ZIG=zig"
if not "%ZIG%"=="zig" if not exist "%ZIG%" (
 echo ERROR: zig.exe not found: %ZIG%
 echo Drop Zig 0.15.2 zig.exe onto this batch file, or put zig on PATH.
 pause
 exit /b 1
)
if not exist dist mkdir dist
rem The HUD / flame / sound / icon files are in src\hud_data.h and src\icon_data.h (generated by scripts\gen_hud_data.py and
rem scripts\gen_icons.py), so no resource compiler is needed.
"%ZIG%" c++ -target x86_64-windows-gnu -std=c++20 -O2 -shared -fms-extensions -fno-exceptions -fno-rtti -Wno-unknown-pragmas -DWIN32_LEAN_AND_MEAN -DNOMINMAX -DUNICODE -D_UNICODE "-DFH3MOD_PLATFORM_VERSION=\"1.0.0\"" -Iinclude -Isrc src\nitro_mod.cpp -luser32 -lkernel32 -lgdi32 -lwinmm -o dist\NitroSystemII.dll
if errorlevel 1 (
 echo BUILD FAILED. Open an issue and paste the messages above.
 pause
 exit /b 1
)
echo.
echo BUILD COMPLETE: dist\NitroSystemII.dll
echo Copy it to ^<Azimuth folder^>\fh3-mods\ (game closed). 
pause
endlocal
