                <Setter Property="Color" Value="#FF00FEEB"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="1"><Setter Property="Color" Value="#FFF4F444"/></DataTrigger>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="2"><Setter Property="Color" Value="#FF2DB2FF"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NosGlowStyle1" TargetType="Path">
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke"><Setter.Value><SolidColorBrush Color="#FF00FEEB" Opacity="0.14"/></Setter.Value></Setter>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="1"><Setter Property="Stroke"><Setter.Value><SolidColorBrush Color="#FFF4F444" Opacity="0.14"/></Setter.Value></Setter></DataTrigger>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="2"><Setter Property="Stroke"><Setter.Value><SolidColorBrush Color="#FF2DB2FF" Opacity="0.14"/></Setter.Value></Setter></DataTrigger>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[18].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NosGlowStyle2" TargetType="Path">
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke"><Setter.Value><SolidColorBrush Color="#FF00FEEB" Opacity="0.14"/></Setter.Value></Setter>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
