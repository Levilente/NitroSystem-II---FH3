            </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="0" Height="0" IsHitTestVisible="False">
<!-- Nitro vignette: two full-screen radial gradients, far bigger than this control and shifted to the middle
             of the 1920x1080 scene. The plugin sets their opacity while the nitro burns (0 = invisible).
             A: the edge tint, opacity from RPMGaugeNumbers[18].YPos.
             B: a wider glow that reaches further in (the Intensity setting), opacity from RPMGaugeNumbers[19].YPos. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="2300" Height="1350" Canvas.Left="-2104" Canvas.Top="-1196"
                IsHitTestVisible="False" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Opacity="{Binding RPMGaugeNumbers[18].YPos}">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#001E78FF" Offset="0"/>
                    <GradientStop Color="#001E78FF" Offset="0.55"/>
                    <GradientStop Color="#081E78FF" Offset="0.65"/>
                    <GradientStop Color="#241E78FF" Offset="0.75"/>
                    <GradientStop Color="#4A1E78FF" Offset="0.85"/>
                    <GradientStop Color="#781E8CFF" Offset="0.95"/>
                    <GradientStop Color="#A01E8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
