                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[19].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
