<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ForzaUI" 
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    x:Class="ForzaUI.HUDSpeedometerControl"
    x:Name="UserControl">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
          <ResourceDictionary.MergedDictionaries>
              <ResourceDictionary Source="/Resources/Anthem/Shared_Hud.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            -->
            <!-- NOS colours of the three HUD themes; item 14's X (set by the mod) picks one: 0 FH3 (the gear's cyan), 1 FH2 (yellow), 2 FH2 Fast & Furious -->
            <Style x:Key="NosFillStyle" TargetType="Path">
                <Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FF00FEEB"/></Setter.Value></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="1"><Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FFF4F444"/></Setter.Value></Setter></DataTrigger>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="2"><Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FF2DB2FF"/></Setter.Value></Setter></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NosBorderStyle" TargetType="Path">
                <Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FF00B2A4"/></Setter.Value></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="1"><Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FFB3B32F"/></Setter.Value></Setter></DataTrigger>
                    <DataTrigger Binding="{Binding Path=DataContext.RPMGaugeNumbers[14].XPos, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="2"><Setter Property="Fill"><Setter.Value><SolidColorBrush Color="#FF1D7FBF"/></Setter.Value></Setter></DataTrigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="A_Brush_NosPillBackground" Color="#35FFFFFF"/>
